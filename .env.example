# Ye file sirf yaad dilane ke liye hai. Asli keys Render ke Environment Variables mein daalo.
# Koi bhi asli key GitHub, screenshot ya chat mein mat bhejna.

# --- Zaroori ---
# NODE_ENV=production
# PORT=10000
# Database ki file. Render par ise Persistent Disk ke path par rakho (jaise /var/data/apna-business.db),
# warna har deploy par data mit sakta hai.
# DATABASE_PATH=/var/data/apna-business.db

# --- AI chat aur receipt photo padhna (Gemini) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# --- Owner admin page ---
# PLATFORM_ADMIN_EMAIL=

# --- Password reset email (optional, verified domain chahiye) ---
# RESEND_API_KEY=
# RESET_EMAIL_FROM=APNA BUSINESS <no-reply@your-verified-domain.example>
# APP_BASE_URL=https://your-app.example
